{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defence submission v4.0",
  "$comment": "Companion validator.py enforces dynamic bounds, referential integrity, unique identifiers, duplicate JSON keys, integer lexical strictness ordered disjoint common phase periods and scheduling feasibility (exactly one slot per session; online predefences have no room).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "student_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "phase": {
            "enum": [
              "predefence",
              "final"
            ]
          },
          "day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "room_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            ]
          },
          "president_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "examiner_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "student_id",
          "phase",
          "day",
          "slot",
          "room_id",
          "president_id",
          "examiner_id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "predefence"
                }
              }
            },
            "then": {
              "properties": {
                "room_id": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "room_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "sessions"
  ],
  "additionalProperties": false
}
