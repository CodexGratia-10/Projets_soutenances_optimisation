{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Defence instance v4.0",
  "$comment": "Companion validator.py enforces dynamic bounds, referential integrity, unique identifiers, duplicate JSON keys, integer lexical strictness ordered disjoint common phase periods and scheduling feasibility (exactly one slot per session; online predefences have no room).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "size": {
      "enum": [
        "demo",
        "small",
        "medium",
        "large"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "slots_per_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "predefence_days": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "final_defence_days": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "teachers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "eligible_roles": {
            "type": "array",
            "items": {
              "enum": [
                "president",
                "examiner"
              ]
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "max_sessions_per_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "availability": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "day",
                "slots"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "domains",
          "eligible_roles",
          "max_sessions_per_day",
          "availability"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "max_sessions_per_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "availability": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "day",
                "slots"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "max_sessions_per_day",
          "availability"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "supervisor_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "eligible_final": {
            "type": "boolean"
          },
          "availability": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "day",
                "slots"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "domain",
          "supervisor_id",
          "eligible_final",
          "availability"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "size",
    "seed",
    "days",
    "slots_per_day",
    "predefence_days",
    "final_defence_days",
    "domains",
    "teachers",
    "rooms",
    "students"
  ],
  "additionalProperties": false
}
